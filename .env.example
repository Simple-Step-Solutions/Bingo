# Firebase config -- get these from the Firebase console under Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# NOT (default). This project uses a NAMED Firestore database; anything that
# omits it silently reads and writes an empty (default) database with no error.
VITE_FIREBASE_DATABASE_ID=

# Web Push certificate key pair, from Project Settings > Cloud Messaging.
# Required for notifications; used by src/firebase.ts and set in CI.
VITE_FIREBASE_VAPID_KEY=

# Local dev URL
APP_URL=http://localhost:3000
