rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // PHASE 1 HARDENING (rules-only hotfix).
    //
    // Role is still read from users/{uid}.role. Phase 2 replaces this
    // with custom claims and moves writes behind callable functions.
    // Until then the critical change is: a user can no longer assign
    // themselves any role other than 'player'. Business and chamber
    // accounts are promoted by an admin from the admin panel.
    // ===============================================================

    // --------------------------- Helpers ---------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function docRole() {
      return userExists() ? userDoc().get('role', 'player') : 'player';
    }

    function isAdmin() {
      return isAuthenticated() && (
        docRole() == 'admin' ||
        // Bootstrap admin. Removed in Phase 2 in favour of a callable.
        (request.auth.token.email == "logan@simplestepsolutions.com" &&
         request.auth.token.email_verified == true)
      );
    }

    function isChamber() {
      return isAuthenticated() && (isAdmin() || docRole() == 'chamber');
    }

    function isBusinessRole() {
      return isAuthenticated() && docRole() == 'business';
    }

    function callerBusinessId() {
      return userExists() ? userDoc().get('businessId', '') : '';
    }

    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Fields a user may change on their own profile. Deliberately
    // excludes role and businessId. bingoBoard and boardSize remain
    // here only until Phase 2 moves boards to boards/{uid}.
    function selfEditableKeys() {
      return ['displayName', 'town', 'currentLocation', 'lastActive', 'lastReadAt',
              'fcmTokens', 'onboardingComplete', 'tourCompleted', 'roleSelected',
              'bingoBoard', 'boardSize'];
    }

    // Fields chamber staff may override on another profile.
    // Never role and never email.
    function chamberEditableKeys() {
      return ['town', 'bingoBoard', 'boardSize', 'onboardingComplete',
              'tourCompleted', 'businessId'];
    }

    // ===============================================================
    // Users
    // ===============================================================

    match /users/{userId} {
      allow get:  if isAuthenticated() && (request.auth.uid == userId || isChamber());
      allow list: if isChamber();

      // Matches the client bootstrap in src/App.tsx. Pinned literals mean
      // a new account cannot be created as anything but an unselected player.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'role', 'roleSelected', 'town'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'player'
        && request.resource.data.roleSelected == false;

      allow update: if isAuthenticated() && (
        // 1. Self, profile fields only. role is not in the allowlist, so
        //    it cannot change through this branch at all.
        (request.auth.uid == userId && affected().hasOnly(selfEditableKeys()))

        // 2. Self, first-time role selection. Locked to player.
        //    Business and chamber promotion goes through an admin until
        //    the redeemInvite callable lands in Phase 2.
        || (request.auth.uid == userId
            && affected().hasOnly(selfEditableKeys().concat(['role']))
            && resource.data.get('roleSelected', true) == false
            && request.resource.data.get('roleSelected', false) == true
            && request.resource.data.role == 'player')

        // 3. Chamber overrides for resets and business linking.
        || (isChamber() && affected().hasOnly(chamberEditableKeys()))

        // 4. Admin. Phase 2 moves role changes to a callable so the
        //    document and the custom claim cannot drift apart.
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Businesses / Towns / Settings / Winners
    // Read by any authenticated user, written by chamber staff.
    // Phase 2 splits qrCode and nfcId out of businesses.
    // ===============================================================

    match /businesses/{businessId} {
      allow read:  if isAuthenticated();
      allow write: if isChamber();
    }

    match /towns/{townId} {
      allow read:  if isAuthenticated();
      allow write: if isChamber();
    }

    match /settings/{settingId} {
      allow read:  if isAuthenticated();
      allow write: if isChamber();
    }

    match /winners/{winnerId} {
      allow read:  if isAuthenticated();
      allow write: if isChamber();
    }

    // ===============================================================
    // Completions
    // Previously any authenticated user could list the whole
    // collection. Now: your own, your linked business, or chamber.
    // Phase 2 replaces create with the verifyVisit callable.
    // ===============================================================

    match /completions/{completionId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || isChamber()
        || (isBusinessRole() && resource.data.businessId == callerBusinessId())
      );

      allow list: if isChamber()
        || (isAuthenticated() && resource.data.userId == request.auth.uid)
        || (isBusinessRole() && resource.data.businessId == callerBusinessId());

      allow create: if isAuthenticated()
        && (request.resource.data.userId == request.auth.uid || isChamber());
      allow update: if isAdmin();
      allow delete: if isChamber();
    }

    // ===============================================================
    // Raffle Entries
    // Previously any authenticated user could list every entry,
    // which exposed userName and userEmail for every participant.
    // ===============================================================

    match /raffle_entries/{entryId} {
      allow get:  if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isChamber());
      allow list: if isChamber()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isChamber();
    }

    // ===============================================================
    // Activities
    // Orphaned by commit 6fa0a3a. Removed entirely in Phase 3.
    // ===============================================================

    match /activities/{activityId} {
      allow read:   if isChamber();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // ===============================================================
    // Notifications
    // Read stays open to all authenticated users for now because
    // Navbar.tsx listens unfiltered. Scoped to ['all', uid] one
    // release after that client change ships.
    // ===============================================================

    match /notifications/{notificationId} {
      allow read:   if isAuthenticated();
      allow create: if isChamber();
      allow delete: if isChamber();
    }

    // ===============================================================
    // Audit Log
    // Append-only, and the actor can no longer be forged.
    // ===============================================================

    match /audit_log/{logId} {
      allow read:   if isChamber();
      allow create: if isChamber()
        && request.resource.data.actorUid == request.auth.uid;
    }

    // ===============================================================
    // Invites
    // Previously listable and updatable by every authenticated user,
    // which leaked every token and allowed replaying a spent chamber
    // invite. Players now have no access at all. Redemption moves to
    // the redeemInvite callable in Phase 2.
    // ===============================================================

    match /invites/{inviteId} {
      allow get, list: if isChamber();
      allow create:    if isChamber();
      allow update:    if false;
      allow delete:    if isChamber();
    }
  }
}
