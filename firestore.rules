rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // PHASE 2 RULES
    //
    // Roles come from a custom claim that the syncRoleClaims trigger
    // projects from users/{uid}.role. Rules read the claim; the
    // document remains the human-editable source of truth.
    //
    // DUAL TRUST, deliberately. Every role helper accepts the claim OR
    // the document. The PWA caches its own JavaScript, so during the
    // overlap there are users signed in with tokens minted before the
    // trigger existed. Dropping the document fallback before those
    // tokens have all rotated would lock chamber staff out of the
    // admin panel. Step 8 of the rollout removes the fallback.
    //
    // Anything genuinely dangerous is NOT defended here. It lives in a
    // callable, which can check tokensValidAfterTime and therefore does
    // not inherit the up-to-an-hour demotion lag that rules do.
    // ===============================================================

    // --------------------------- Helpers ---------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    // Custom claim path. Zero reads. An absent claim means 'player',
    // which is why existing players needed no backfill.
    function claimRole() {
      return request.auth.token.get('role', 'player');
    }

    function claimBusinessId() {
      return request.auth.token.get('bid', '');
    }

    // Document path, kept only for the overlap. Costs a get() per
    // evaluation, which is why the claim is checked first everywhere.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function docRole() {
      return userExists() ? userDoc().get('role', 'player') : 'player';
    }

    function isAdmin() {
      return isAuthenticated() && (claimRole() == 'admin' || docRole() == 'admin');
    }

    function isChamber() {
      return isAuthenticated() && (
        claimRole() == 'chamber' || claimRole() == 'admin'
        || docRole() == 'chamber' || docRole() == 'admin'
      );
    }

    function isBusinessRole() {
      return isAuthenticated() && (claimRole() == 'business' || docRole() == 'business');
    }

    function callerBusinessId() {
      return claimBusinessId() != ''
        ? claimBusinessId()
        : (userExists() ? userDoc().get('businessId', '') : '');
    }

    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Fields a user may change on their own profile. Deliberately
    // excludes role, businessId, and email.
    //
    // bingoBoard and boardSize are still here because a client running
    // a cached bundle may still write them. They are ignored: the game
    // reads boards/{uid}, which no client can write. They come out in
    // step 8 along with the document fallback.
    function selfEditableKeys() {
      return ['displayName', 'town', 'currentLocation', 'lastActive', 'lastReadAt',
              'fcmTokens', 'onboardingComplete', 'tourCompleted', 'roleSelected',
              'bingoBoard', 'boardSize'];
    }

    // Fields chamber staff may override on another profile.
    // Never role, never email, never businessId -- businessId now
    // implies a claim, so it has to move through setUserRole.
    function chamberEditableKeys() {
      return ['town', 'bingoBoard', 'boardSize', 'onboardingComplete', 'tourCompleted'];
    }

    // ===============================================================
    // Users
    // ===============================================================

    match /users/{userId} {
      allow get:  if isAuthenticated() && (request.auth.uid == userId || isChamber());
      allow list: if isChamber();

      // Matches the client bootstrap in src/App.tsx. Pinned literals mean
      // a new account cannot be created as anything but an unselected player.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'role', 'roleSelected', 'town'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'player'
        && request.resource.data.roleSelected == false;

      allow update: if isAuthenticated() && (
        // 1. Self, profile fields only. role is not in the allowlist, so
        //    it cannot change through this branch at all.
        (request.auth.uid == userId && affected().hasOnly(selfEditableKeys()))

        // 2. Self, first-time role selection, locked to player. Business
        //    and chamber promotion happens inside redeemInvite, which
        //    writes with the Admin SDK and bypasses these rules.
        || (request.auth.uid == userId
            && affected().hasOnly(selfEditableKeys().concat(['role']))
            && resource.data.get('roleSelected', true) == false
            && request.resource.data.get('roleSelected', false) == true
            && request.resource.data.role == 'player')

        // 3. Chamber overrides for resets. No role, no businessId.
        || (isChamber() && affected().hasOnly(chamberEditableKeys()))
      );

      // Admin is NOT a blanket update branch any more. Role changes go
      // through setUserRole so the document and the claim cannot drift
      // apart, and so a demotion can revoke refresh tokens.
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Businesses / Towns / Settings / Winners
    // ===============================================================

    match /businesses/{businessId} {
      allow read: if isAuthenticated();

      // qrCode and nfcId must never come back. They are what made every
      // code in the game derivable from a player's own board.
      allow write: if isChamber()
        && !request.resource.data.keys().hasAny(['qrCode', 'nfcId']);
    }

    match /towns/{townId} {
      allow read:  if isAuthenticated();
      allow write: if isChamber();
    }

    match /settings/{settingId} {
      allow read:  if isAuthenticated();
      allow write: if isChamber();
    }

    match /winners/{winnerId} {
      allow read:  if isAuthenticated();
      allow write: if isChamber();
    }

    // ===============================================================
    // Business secrets and the code index
    //
    // The split that makes codes unguessable. Secrets are readable by
    // the chamber and the owning business, and by nobody else. The
    // index is readable by nobody at all: it is the hash -> business
    // map, and being able to read it would defeat the hashing.
    //
    // Both are written exclusively by the Admin SDK.
    // ===============================================================

    match /business_secrets/{businessId} {
      allow get: if isChamber()
        || (isBusinessRole() && callerBusinessId() == businessId);
      allow list, write: if false;
    }

    match /code_index/{codeHash} {
      allow read, write: if false;
    }

    // ===============================================================
    // Boards
    //
    // Read your own, or chamber for support. Written only by
    // ensureBoard and regenerateBoard. A player who can rewrite their
    // board picks nine businesses in one strip mall and wins in ten
    // minutes without leaving the parking lot.
    // ===============================================================

    match /boards/{userId} {
      allow get:  if isAuthenticated() && (request.auth.uid == userId || isChamber());
      allow list: if isChamber();
      allow write: if false;
    }

    // ===============================================================
    // Completions
    //
    // create and update are closed entirely: verifyVisit is the only
    // way a completion comes into existence, which is what makes the
    // geofence and the duplicate check unskippable.
    // ===============================================================

    match /completions/{completionId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || isChamber()
        || (isBusinessRole() && resource.data.businessId == callerBusinessId())
      );

      allow list: if isChamber()
        || (isAuthenticated() && resource.data.userId == request.auth.uid)
        || (isBusinessRole() && resource.data.businessId == callerBusinessId());

      allow create, update: if false;
      allow delete: if isChamber();
    }

    // ===============================================================
    // Wins and verification attempts
    //
    // Both are server-written evidence. A player may see their own win
    // so the app can show the fanfare; nobody may write either.
    // ===============================================================

    match /wins/{userId} {
      allow get:  if isAuthenticated() && (request.auth.uid == userId || isChamber());
      allow list: if isChamber();
      allow write: if false;
    }

    match /verification_attempts/{attemptId} {
      allow read:  if isChamber();
      allow write: if false;
    }

    // ===============================================================
    // Raffle Entries
    // ===============================================================

    match /raffle_entries/{entryId} {
      allow get:  if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isChamber());
      allow list: if isChamber()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isChamber();
    }

    // ===============================================================
    // Activities
    // ===============================================================

    match /activities/{activityId} {
      allow read:   if isChamber();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // ===============================================================
    // Notifications
    // Read stays open to all authenticated users for now because
    // Navbar.tsx listens unfiltered. Scoped to ['all', uid] one
    // release after that client change ships.
    // ===============================================================

    match /notifications/{notificationId} {
      allow read:   if isAuthenticated();
      allow create: if isChamber();
      allow delete: if isChamber();
    }

    // ===============================================================
    // Audit Log
    // Append-only, and the actor can no longer be forged. Server-side
    // entries are written with the Admin SDK and skip these rules.
    // ===============================================================

    match /audit_log/{logId} {
      allow read:   if isChamber();
      allow create: if isChamber()
        && request.resource.data.actorUid == request.auth.uid;
    }

    // ===============================================================
    // Invites
    //
    // Documents are keyed by sha256(token) and carry no plaintext, so
    // even a chamber read yields nothing replayable. Players have no
    // access at all. Creation, redemption and revocation are callables.
    // ===============================================================

    match /invites/{inviteId} {
      allow get, list: if isChamber();
      allow write:     if false;
    }

    // ===============================================================
    // Rate limits
    // Admin SDK only. Set a TTL policy on expiresAt in the console so
    // these are reaped rather than accumulating forever.
    // ===============================================================

    match /rate_limits/{bucketId} {
      allow read, write: if false;
    }
  }
}
