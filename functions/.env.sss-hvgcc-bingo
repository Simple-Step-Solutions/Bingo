# Deploy-time parameter values for this project.
#
# EVERY defineString()/defineInt()/etc. in functions/ must have a value here.
# A default in the code is NOT enough: firebase-tools resolves params by
# checking these dotenv files first, and under --non-interactive it throws
#
#   In non-interactive mode but have no value for the following environment
#   variables: <NAME>
#
# for anything missing -- BEFORE it ever looks at the default. The default is
# only used to pre-fill the interactive prompt, so it does nothing in CI.
#
# None of these are secrets. The database id already ships to every browser as
# VITE_FIREBASE_DATABASE_ID, and the bootstrap admin address is already the
# literal default in functions/invites.js. They live in the repo rather than in
# CI secrets, where an empty value would silently point every Cloud Function at
# an empty (default) database.

# Firestore: the app runs on a NAMED database, never (default).
FIRESTORE_DATABASE_ID=ai-studio-b22a3d46-2072-4ec8-b7cc-b2370d5fdd10

# The one account allowed to mint the first chamber invite. See
# functions/invites.js.
BOOTSTRAP_ADMIN_EMAIL=logan@simplestepsolutions.com
